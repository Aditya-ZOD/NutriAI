# ==============================================================================
# NutriAI Environment Configuration Template
# Copy this file to .env and adjust variables as needed.
# ==============================================================================

# Ollama local host and model configuration
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# Allowed CORS origins (comma-separated, without trailing slashes)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500

# SQLite Database path (optional override)
NUTRI_DB_PATH=users.db
